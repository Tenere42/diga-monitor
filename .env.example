BREVO_API_KEY=your-brevo-api-key
DIGA_MONITOR_EMAIL_FROM=updates@diga-tracker.de
DIGA_MONITOR_EMAIL_FROM_NAME=DiGA Tracker
DIGA_MONITOR_EMAIL_TO=recipient@example.com
DIGA_MONITOR_DASHBOARD_URL=https://www.diga-tracker.de
# Legacy/technical fallback, used only if DIGA_MONITOR_DASHBOARD_URL is not set
# (e.g. the current Streamlit hosting URL during local development).
DASHBOARD_URL=http://localhost:8501
R2_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=diga-monitor
R2_ACCESS_KEY_ID=example-access-key-id
R2_SECRET_ACCESS_KEY=example-secret-access-key

# --- Public newsletter (DiGA Tracker Alerts, Brevo double opt-in) ---
# Reuses BREVO_API_KEY, DIGA_MONITOR_EMAIL_FROM, and DIGA_MONITOR_EMAIL_FROM_NAME
# above. The API key must have Contacts, Double Opt-in, and Email Campaign
# scope in Brevo -- verify this in the Brevo dashboard before going live.
# Brevo contact list holding *confirmed* DOI subscribers only.
BREVO_NEWSLETTER_LIST_ID=your-brevo-confirmed-list-id
# Brevo double opt-in confirmation email template id (created in Brevo).
BREVO_DOI_TEMPLATE_ID=your-brevo-doi-template-id
# Page Brevo redirects to after a subscriber confirms their address.
BREVO_DOI_REDIRECT_URL=https://www.diga-tracker.de/?view=confirmed

# --- Legal-ready gate for the newsletter feature (see src/legal_content.py) ---
# Minimal-disclosure principle: only what has an identified legal basis is
# required here. A postal address and commercial register entry are
# intentionally NOT collected -- see docs/legal-notes.md. The
# international-transfer statement is NOT a free-form field either; it is
# a fixed, sourced statement in src/legal_content.py based on Brevo's and
# Railway's own published Data Processing Agreements.
#
# Master switch. Do not set to "true" until both fields below are filled in
# with real, confirmed values -- never invented. Until this switch is
# "true" and both fields are set, the newsletter signup, subscriber
# alerts, and Datenschutzerklaerung page stay completely hidden on the
# public site.
NEWSLETTER_LEGAL_READY=false
# Reachable contact address for privacy/data-subject-rights requests --
# does not have to be a postal address (see docs/legal-notes.md).
DIGA_TRACKER_OPERATOR_CONTACT_EMAIL=your-confirmed-operator-contact-email
DIGA_TRACKER_DATA_RETENTION_PERIOD=your-confirmed-data-retention-period
