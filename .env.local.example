# Local Streamlit newsletter E2E test only.
# Never use this file as a template for Railway or production configuration.
# Copy it to .env.local, then replace the two clearly marked placeholders
# below with the real values before starting the local test launcher.

# Brevo API key used for the local signup and double opt-in request.
BREVO_API_KEY=your-brevo-api-key-here
# Brevo contact list holding confirmed DOI subscribers.
BREVO_NEWSLETTER_LIST_ID=3
# Brevo double opt-in confirmation email template id.
BREVO_DOI_TEMPLATE_ID=1
# Forced to this localhost URL again by the launcher as a safety net.
BREVO_DOI_REDIRECT_URL=http://localhost:8501/?view=confirmed

# Local test-session gate. The launcher forces this to true for its process.
NEWSLETTER_LEGAL_READY=true
# Reachable contact address shown in the local privacy notice.
DIGA_TRACKER_OPERATOR_CONTACT_EMAIL=datenschutz@diga-tracker.de
# Replace with the real, confirmed retention text before starting the test.
DIGA_TRACKER_DATA_RETENTION_PERIOD=your-confirmed-retention-text-here
